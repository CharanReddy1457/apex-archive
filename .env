# Database configuration
# Default: Local SQLite for zero-config out-of-the-box local development
DATABASE_URL="file:./dev.db"

# For PostgreSQL / Supabase in production:
# DATABASE_URL="postgresql://postgres:your-password@db.your-supabase-project.supabase.co:5432/postgres?pgbouncer=true"

# Security & Authentication
JWT_SECRET="academic-knowledge-repository-ultra-secure-key-2025"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# File Storage ("local" or "supabase" / "s3")
STORAGE_DRIVER="local"
